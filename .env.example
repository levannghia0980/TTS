# Environment Variables & Configuration Example
# Sao chép file này thành .env trong thư mục backend/ (hoặc root) và điền các khóa phù hợp

# ==========================================
# 1. Cấu hình Gemini AI Translation Service
# ==========================================
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini tối ưu cho tốc độ và chi phí (Chỉ dùng gemini-3.1-flash-lite hoặc gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# ==========================================
# 2. Cấu hình Text-To-Speech (TTS Engine)
# ==========================================
# TTS Engine mặc định: capcut | edge | local
TTS_ENGINE=capcut

# Giọng đọc mặc định khi khởi động:
# - CapCut / TikTok: BV074_streaming (Nam truyền cảm review), BV075_streaming (Nữ truyền cảm)
# - Microsoft Edge: vi-VN-HoaiMyNeural (Nữ chuẩn), vi-VN-NamMinhNeural (Nam chuẩn)
# - Local Piper VITS: local_ngoc_huyen_new (Nữ miền Bắc offline)
SELECTED_VOICE=BV074_streaming

# Số luồng tổng hợp âm thanh song song tối đa
TTS_MAX_WORKERS=32

# Cookie CapCut hoặc Session ID TikTok để gọi API đám mây (Tùy chọn)
CAPCUT_COOKIE=
TIKTOK_SESSION_ID=410bfa37bdc185e1c6da82e1afb48409

# ==========================================
# 3. Cấu hình Mô hình Offline Piper VITS
# ==========================================
# Đường dẫn tuyệt đối đến mô hình .onnx và file cấu hình .json trên máy (tùy chọn khi dùng offline)
LOCAL_PIPER_MODEL_PATH=D:\NENGHIA0980\AIREAD\models\ngoc_huyen_new\ngochuyennew.onnx
LOCAL_PIPER_CONFIG_PATH=D:\NENGHIA0980\AIREAD\models\ngoc_huyen_new\ngochuyennew.onnx.json

